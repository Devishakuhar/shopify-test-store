
{% assign selected_variant = product.selected_or_first_available_variant %}
{% assign color_option_position = 0 %}

{% for option in product.options_with_values %}
  {% assign option_name = option.name | downcase %}
  {% if option_name == 'color' or option_name == 'colour' %}
    {% assign color_option_position = option.position %}
  {% endif %}
{% endfor %}

<article
  class="custom-product-card"
  data-product-card
  data-product-id="{{ product.id }}"
  data-section-id="{{ section_id }}"
>
  <script type="application/json" data-product-json>
    {{ product | json }}
  </script>

  <div class="custom-product-card__media">
    <a
      href="{{ product.url }}?variant={{ selected_variant.id }}"
      class="custom-product-card__link"
      data-product-link
      aria-label="{{ product.title | escape }}"
    >
      {% if selected_variant.featured_image %}
        {% assign card_image = selected_variant.featured_image %}
      {% else %}
        {% assign card_image = product.featured_image %}
      {% endif %}

      {% if card_image %}
        <img
          src="{{ card_image | image_url: width: 700 }}"
          alt="{{ card_image.alt | default: product.title | escape }}"
          width="{{ card_image.width }}"
          height="{{ card_image.height }}"
          loading="lazy"
          data-product-image
        >
      {% else %}
        {{ 'product-1' | placeholder_svg_tag: 'custom-product-card__placeholder' }}
      {% endif %}
    </a>

    {% if selected_variant.compare_at_price > selected_variant.price %}
      {% assign discount = selected_variant.compare_at_price
        | minus: selected_variant.price
        | times: 100.0
        | divided_by: selected_variant.compare_at_price
        | round
      %}
      <span class="custom-product-card__badge" data-discount-badge>
        {{ discount }}% OFF
      </span>
    {% else %}
      <span class="custom-product-card__badge" data-discount-badge hidden></span>
    {% endif %}
  </div>

  <div class="custom-product-card__content">

    <a
      href="{{ product.url }}?variant={{ selected_variant.id }}"
      class="custom-product-card__title"
      data-product-link
    >
      {{ product.title | escape }}
    </a>

    <div class="custom-product-card__price" data-product-price>
      <span class="custom-product-card__selling-price" data-selling-price>
        {{ selected_variant.price | money }}
      </span>

      <s
        class="custom-product-card__compare-price"
        data-compare-price
        {% unless selected_variant.compare_at_price > selected_variant.price %}
          hidden
        {% endunless %}
      >
        {{ selected_variant.compare_at_price | money }}
      </s>
    </div>

 
{% for option in product.options_with_values %}
  {% assign option_index = option.position | minus: 1 %}
  {% assign option_name = option.name | downcase %}
  {% assign is_color = false %}

  {% if option_name == 'color' or option_name == 'colour' %}
    {% assign is_color = true %}
  {% endif %}

  <div
    class="custom-product-card__variant-group {% if is_color %}custom-product-card__color-group{% else %}custom-product-card__size-group{% endif %}"
    data-option-group="{{ option.position }}"
  >
    {% unless is_color %}
      <span class="custom-product-card__option-label">
        {{ option.name | escape }}
      </span>
    {% endunless %}

    <div
      class="{% if is_color and show_swatches %}custom-product-card__swatches{% else %}custom-product-card__option-buttons{% endif %}"
      role="group"
      aria-label="Select {{ option.name | escape }}"
    >
      {% for value in option.values %}
        {% assign value_name = value.name | default: value %}
        {% assign swatch_color = value.swatch.color %}
        {% assign swatch_image = value.swatch.image %}

        {% assign is_selected = false %}
        {% if selected_variant.options[option_index] == value_name %}
          {% assign is_selected = true %}
        {% endif %}

        {% if is_color and show_swatches %}
          <button
            type="button"
            class="custom-product-card__swatch"
            data-option-position="{{ option.position }}"
            data-option-value="{{ value_name | escape }}"
            aria-label="{{ option.name }}: {{ value_name | escape }}"
            aria-pressed="{{ is_selected }}"
            title="{{ value_name | escape }}"
            {% if swatch_color != blank %}
              style="--swatch-color: {{ swatch_color }};"
            {% elsif swatch_image != blank %}
              style="--swatch-image: url('{{ swatch_image | image_url: width: 80 }}');"
            {% endif %}
          >
            {% unless swatch_color != blank or swatch_image != blank %}
              <span class="custom-product-card__swatch-fallback">
                {{ value_name | escape }}
              </span>
            {% endunless %}
          </button>

        {% else %}
          <button
            type="button"
            class="custom-product-card__option-button"
            data-option-position="{{ option.position }}"
            data-option-value="{{ value_name | escape }}"
            aria-label="{{ option.name }}: {{ value_name | escape }}"
            aria-pressed="{{ is_selected }}"
          >
            {{ value_name | escape }}
          </button>
        {% endif %}
      {% endfor %}
    </div>
  </div>
{% endfor %}


    <div class="custom-product-card__availability"
      data-availability
      aria-live="polite"
    ></div>

    <button
      type="button"
      class="custom-product-card__add-to-cart"
      data-add-to-cart
      data-variant-id="{{ selected_variant.id }}"
      {% unless selected_variant.available %}
        disabled
      {% endunless %}
    >
      <span data-button-text>
        {% if selected_variant.available %}
          Add to Cart
        {% else %}
          Sold Out
        {% endif %}
      </span>
    </button>

    <p
      class="custom-product-card__feedback"
      data-cart-feedback
      role="status"
      aria-live="polite"
    ></p>

  </div>
</article>
