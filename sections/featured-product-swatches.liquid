

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">
{{ 'product-card-swatch.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-card-swatch.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign collection = section.settings.collection
  assign limit = section.settings.products_count | default: 4
-%}

<section class="psc-section" id="psc-{{ section.id }}" data-psc-section>
  <div class="psc-section__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="psc-section__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- if collection != blank and collection.products.size > 0 -%}
      <ul class="psc-grid" role="list">
        {%- for product in collection.products limit: limit -%}
          <li class="psc-grid__item">
        {%- assign lazy_load = false -%}
{%- if forloop.index > 4 -%}
  {%- assign lazy_load = true -%}
{%- endif -%}

{%- render 'product-card-swatch',
  product: product,
  show_swatches: section.settings.show_swatches,
  show_tags: section.settings.show_tags,
  color_metafield: section.settings.color_metafield,
  section_id: section.id,
  lazy: lazy_load
-%}
</li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p class="psc-empty">
        {%- if collection == blank -%}
          Choose a collection in the section settings to show products here.
        {%- else -%}
          This collection has no products yet.
        {%- endif -%}
      </p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "custom-featured-product",
  "tag": "div",
  "class": "psc-section-wrapper",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured Products" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    {
      "type": "range", "id": "products_count", "label": "Number of products",
      "min": 4, "max": 8, "step": 1, "default": 4
    },
    { "type": "checkbox", "id": "show_swatches", "label": "Show color swatches", "default": true },
    {
      "type": "text", "id": "color_metafield", "label": "Swatch colour metafield (variant)",
      "default": "custom.color",
      "info": "Variant metafield of type Color, as namespace.key. Used for the colour dots when an option has no native swatch."
    },
    { "type": "checkbox", "id": "show_tags", "label": "Show product tags as chips", "default": true }
  ],
  "presets": [{ "name": "custom-featured-product" }]
}
{% endschema %}
